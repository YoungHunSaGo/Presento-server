# 집 서버용. 서버에서 .env.home으로 복사한 뒤 값을 채운다. .env.home은 절대 커밋하지 않는다.
# docker-compose.home.yml과 deploy/home-update.sh가 읽는다. 비어 있으면 안 되는 값은 비어 있으면
# compose가 시작을 거부한다(비밀번호에 기본값 없음).

# ---- 호스트 포트(같은 서버의 HowMuch, Anima와 겹치지 않게) ----
# 포트를 열 주소. 127.0.0.1이면 서버 안에서만 접속된다. Tailscale로 친구가 접속하게 하려면
# 서버의 Tailscale IP(tailscale ip -4, 예: 100.101.102.103)를 넣는다. 0.0.0.0은 쓰지 않는다.
BIND_ADDR=127.0.0.1
# API 포트(브라우저 → API). 기본 8000
API_PORT=8000
# MinIO 포트(브라우저 → presigned URL로 영상 업로드·재생). 기본 9000
MINIO_PORT=9000

# ---- 파일 저장(MinIO) ----
# 브라우저가 접속하는 MinIO 주소. presigned URL 서명에 이 호스트가 들어가므로 BIND_ADDR·MINIO_PORT와
# 맞춘다. 예: http://100.101.102.103:9000  (서버 안 통신은 http://minio:9000으로 자동 설정)
S3_PUBLIC_ENDPOINT_URL=
S3_BUCKET=presento
# MinIO는 리전을 따로 정하지 않아 아무 값이나 된다(서명에만 쓰임). 한쪽만 바꾸지 말고 그대로 둔다.
S3_REGION=ap-northeast-2
# MinIO 관리자 계정(minio-init만 씀). 접속 주소에 들어가므로 영문·숫자만: openssl rand -hex 24
MINIO_ROOT_USER=presento-admin
MINIO_ROOT_PASSWORD=
# 앱 전용 MinIO 계정(이 버킷만 읽기·쓰기·삭제). minio-init이 만든다. openssl rand -hex 24
MINIO_APP_USER=presento-app
MINIO_APP_PASSWORD=

# ---- DB ----
# URL에 그대로 들어가므로 영문·숫자만: openssl rand -hex 24
# 첫 실행 때 DB가 이 값으로 만들어진다. 나중에 여기만 바꾸면 접속이 실패한다(DB 안에서도 바꿔야 함).
POSTGRES_PASSWORD=

# ---- 인증 ----
# 32자 이상: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-5-mini
OPENAI_LLM_INPUT_USD_PER_1M=0.25
OPENAI_LLM_OUTPUT_USD_PER_1M=2.0

# ---- CORS ----
# 프론트 주소(쉼표로 구분, 쉼표 뒤 공백 없이). API와 MinIO(업로드·재생) 둘 다 이 값으로 허용한다.
# https://presento2*.vercel.app 같은 와일드카드도 API·MinIO 모두 동작한다.
CORS_ORIGINS=http://localhost:5173,https://presento2*.vercel.app

# ---- 파이프라인·비용 보호 ----
# true면 가짜 리포트(OpenAI 호출 없음)
USE_FAKE_PIPELINE=false
MAX_VIDEO_SECONDS=600
MAX_VIDEO_BYTES=2147483648
DAILY_ANALYSIS_LIMIT=20
VIDEO_RETENTION_DAYS=7
