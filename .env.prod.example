# 운영(EC2)용. 서버에서 .env.prod로 복사한 뒤 값을 채운다. .env.prod는 절대 커밋하지 않는다.
# docker-compose.prod.yml과 deploy/update.sh가 읽는다.

# 도메인: 탄력적 IP 3.38.12.34 → api.3-38-12-34.sslip.io (Caddy가 HTTPS 인증서를 자동 발급)
DOMAIN=

# DB 비밀번호. URL에 그대로 들어가므로 영문·숫자만: openssl rand -hex 24
POSTGRES_PASSWORD=

# OpenAI
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-5-mini
OPENAI_LLM_INPUT_USD_PER_1M=0.25
OPENAI_LLM_OUTPUT_USD_PER_1M=2.0

# 인증. 32자 이상: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# 파일 저장: AWS S3(서울). 접속 주소는 비워 두면 AWS 기본 주소를 쓴다.
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=ap-northeast-2
# EC2 인스턴스 IAM 역할로 접근하므로 키는 비워 둔다(비우면 boto3 기본 자격 증명 사용).
S3_ACCESS_KEY=
S3_SECRET_KEY=

# CORS: 쉼표로 구분. 프론트를 배포하면 그 주소를 뒤에 추가한다(S3 버킷 CORS에도 같이 추가).
# 예: CORS_ORIGINS=http://localhost:5173,https://presento.example.com
CORS_ORIGINS=http://localhost:5173

# 파이프라인: true면 가짜 리포트(OpenAI 호출 없음)
USE_FAKE_PIPELINE=false

# 비용 보호
MAX_VIDEO_SECONDS=600
MAX_VIDEO_BYTES=2147483648
DAILY_ANALYSIS_LIMIT=20
