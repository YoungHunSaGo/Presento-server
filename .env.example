# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 절대 커밋하지 않는다.

# OpenAI
OPENAI_API_KEY=
OPENAI_LLM_MODEL=

# 인증
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# DB / 큐
DATABASE_URL=postgresql+psycopg://presento:presento@localhost:5432/presento
REDIS_URL=redis://localhost:6379/0

# 파일 저장 (로컬은 MinIO)
S3_ENDPOINT_URL=http://localhost:9000
# presigned URL 서명 주소(브라우저가 접속하는 주소). 비우면 S3_ENDPOINT_URL 사용
S3_PUBLIC_ENDPOINT_URL=
S3_BUCKET=presento
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=ap-northeast-2

# CORS
CORS_ORIGINS=http://localhost:5173

# 비용 보호
MAX_VIDEO_SECONDS=600
MAX_VIDEO_BYTES=524288000
DAILY_ANALYSIS_LIMIT=20
