# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 절대 커밋하지 않는다.

# OpenAI
OPENAI_API_KEY=
OPENAI_LLM_MODEL=
# LLM 예상 비용 로그용 단가(USD / 100만 토큰, gpt-5-mini 기준)
OPENAI_LLM_INPUT_USD_PER_1M=0.25
OPENAI_LLM_OUTPUT_USD_PER_1M=2.0

# 인증
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# DB / 큐
DATABASE_URL=postgresql+psycopg://presento:presento@localhost:5432/presento
REDIS_URL=redis://localhost:6379/0

# 파일 저장 (로컬은 MinIO)
S3_ENDPOINT_URL=http://localhost:9000
# presigned URL 서명 주소(브라우저가 접속하는 주소). 비우면 S3_ENDPOINT_URL 사용
S3_PUBLIC_ENDPOINT_URL=
S3_BUCKET=presento
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=ap-northeast-2

# CORS
CORS_ORIGINS=http://localhost:5173

# MediaPipe 모델 파일 (Docker는 /opt/models에 자동으로 받음. 로컬 실행 시에만 지정)
MEDIAPIPE_FACE_MODEL_PATH=/opt/models/face_landmarker.task
MEDIAPIPE_POSE_MODEL_PATH=/opt/models/pose_landmarker_full.task

# 파이프라인: true면 가짜 리포트(프론트 개발용, OpenAI 호출 없음)
USE_FAKE_PIPELINE=false

# 비용 보호
MAX_VIDEO_SECONDS=600
MAX_VIDEO_BYTES=2147483648
DAILY_ANALYSIS_LIMIT=20
VIDEO_RETENTION_DAYS=7
